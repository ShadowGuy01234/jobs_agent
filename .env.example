# ==============================================================================
# 🤖 LLM GATEWAY PROVIDER (Toggle: 'tokenrouter', 'openrouter', or 'groq')
# ==============================================================================
LLM_PROVIDER=tokenrouter

# --- TOKENROUTER CONFIGURATION (Main Model: GLM 5.3 Flash / Free) ---
TOKENROUTER_API_KEY=your_tokenrouter_api_key_here
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_FAST_MODEL=z-ai/glm-5.3-free
TOKENROUTER_SMART_MODEL=z-ai/glm-5.3-free

# --- OPENROUTER CONFIGURATION (Optional fallback) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FAST_MODEL=deepseek/deepseek-chat
OPENROUTER_SMART_MODEL=deepseek/deepseek-chat

# --- GROQ CONFIGURATION (Blazing fast inference / Optional fallback) ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_SMART_MODEL=llama-3.3-70b-versatile

# ==============================================================================
# 🔍 SEARCH & CONTACT ENRICHMENT
# ==============================================================================
TAVILY_API_KEY=your_tavily_api_key_here
# Optional free-tier keys (system uses Tavily + pattern matching as fallback)
HUNTER_API_KEY=
APOLLO_API_KEY=

# ==============================================================================
# 📱 TELEGRAM BOT (Long-Polling / No Inbound Ports)
# ==============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ==============================================================================
# ✉️ GMAIL SMTP DELIVERY
# ==============================================================================
GMAIL_USER=yourname@gmail.com
# Create a 16-char App Password at https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ==============================================================================
# ⚙️ SYSTEM & TARGETING CONTROLS
# ==============================================================================
DATABASE_PATH=data/outreach.db
MIN_FIT_SCORE=75
MAX_ALERTS_PER_DAY=10
# Set DRY_RUN=true to simulate email sending without dispatching real emails
DRY_RUN=true
# Safety cap on real emails sent per day once DRY_RUN=false (cold-outreach deliverability pacing)
MAX_LIVE_SENDS_PER_DAY=20

# ==============================================================================
# ☁️ ORACLE CLOUD ALWAYS FREE ANTI-IDLE HEARTBEAT
# ==============================================================================
ORACLE_HEARTBEAT_ENABLED=true
HEARTBEAT_INTERVAL_HOURS=4

# Server Port (for healthchecks and optional manual webhooks)
PORT=8000
HOST=0.0.0.0
